# ─── Environment Variables for manteis-systems ──────────────────────────────
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and contains real secrets.

# Vercel CLI (auto-generated when running `vercel link`)
VERCEL_OIDC_TOKEN=""

# ─── Stripe Payment Links ───────────────────────────────────────────────────
# Each product gets a Payment Link URL from the Stripe Dashboard.
# Dashboard → Products → Create product → Set price → Create payment link → Copy URL
# When set, the products page buy buttons activate automatically.
# When empty/unset, buttons show "COMING SOON".
NEXT_PUBLIC_STRIPE_LINK_STARTER_KIT=""
NEXT_PUBLIC_STRIPE_LINK_BTNC=""
NEXT_PUBLIC_STRIPE_LINK_KYBALION=""
NEXT_PUBLIC_STRIPE_LINK_SEWA=""
NEXT_PUBLIC_STRIPE_LINK_BUNDLE=""

# ─── Google Analytics (GA4) ─────────────────────────────────────────────────
# Set to your GA4 Measurement ID (G-XXXXXXXXXX) to enable analytics.
# When unset, the GA script is not injected (no tracking).
NEXT_PUBLIC_GA_ID=""

# ─── n8n Webhook (lead capture) ─────────────────────────────────────────────
# The assessment form and contact form POST to this n8n webhook URL.
# n8n handles: CRM insert, auto-reply email, iMessage notification, Plane issue.
N8N_WEBHOOK_URL="http://localhost:5678/webhook/lead-capture"